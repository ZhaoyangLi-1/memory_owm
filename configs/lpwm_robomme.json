{
  "_comment": [
    "LPWM on RoboMME, derived from lpwm/configs/bridge.json (the official robot-tabletop config; it is 128 px \u2014 the repo has NO 256 px config).",
    "Unconditional: language_condition / action_condition / image goal are all off.",
    "256 px changes that are REQUIRED for the CNNs to build (verified): patch_size 32 with n_kp_prior 64 (n_kp_prior must equal (image_size/patch_size)^2),",
    "anchor_s 0.125 (32 px glimpses, keeps the official obj_ch_mult) and bg_ch_mult with 6 stages. The particle budget M = 64 is the official bridge value.",
    "timestep_horizon and root are filled in by owm/wm/lpwm_train.py from configs/experiment.yaml: timestep_horizon = context_frames + n_future - 1,",
    "so LPWM and C-JEPA always share the context length. eval_im_metrics / ctx_for_eval are off: ctx_for_eval uses ground-truth future frames."
  ],
  "ds": "robomme",
  "root": "cache/episodes",
  "device": "cuda",
  "batch_size": 1,
  "lr": 8e-05,
  "use_scheduler": false,
  "scheduler_gamma": 0.99,
  "adam_betas": [
    0.9,
    0.999
  ],
  "adam_eps": 1e-06,
  "weight_decay": 0.0,
  "load_model": false,
  "pretrained_path": null,
  "start_epoch": 0,
  "num_epochs": 200,
  "eval_epoch_freq": 1,
  "warmup_epoch": 1,
  "patch_size": 32,
  "n_kp_per_patch": 1,
  "n_kp_enc": 50,
  "n_kp_prior": 64,
  "topk": 20,
  "anchor_s": 0.125,
  "scale_std": 0.3,
  "offset_std": 0.2,
  "obj_on_alpha": 0.01,
  "obj_on_beta": 0.01,
  "recon_loss_type": "vgg",
  "normalize_rgb": false,
  "beta_kl": 0.08,
  "beta_rec": 1.0,
  "kl_balance": 0.01,
  "beta_obj": 0.08,
  "image_size": 256,
  "ch": 3,
  "features_dist": "gauss",
  "learned_feature_dim": 6,
  "learned_bg_feature_dim": 6,
  "n_fg_categories": 8,
  "n_fg_classes": 4,
  "n_bg_categories": 4,
  "n_bg_classes": 4,
  "context_dist": "gauss",
  "context_dim": 7,
  "n_ctx_categories": 8,
  "n_ctx_classes": 4,
  "ctx_pool_mode": "none",
  "action_condition": false,
  "action_dim": 3,
  "null_action_embed": false,
  "language_condition": false,
  "language_embed_dim": 1024,
  "language_max_len": 32,
  "obj_res_from_fc": 8,
  "obj_ch_mult_prior": [
    1,
    4,
    8
  ],
  "obj_ch_mult": [
    1,
    4,
    8
  ],
  "obj_base_ch": 32,
  "obj_final_cnn_ch": 32,
  "bg_res_from_fc": 8,
  "bg_ch_mult": [
    1,
    1,
    1,
    2,
    4,
    4
  ],
  "bg_base_ch": 32,
  "bg_final_cnn_ch": 32,
  "pad_mode": "zeros",
  "num_res_blocks": 1,
  "cnn_mid_blocks": false,
  "use_resblock": false,
  "mlp_hidden_dim": 256,
  "timestep_horizon": 24,
  "num_static_frames": 1,
  "predict_delta": false,
  "use_ep_done_mask": true,
  "beta_dyn": 0.2,
  "beta_dyn_rec": 1.0,
  "dropout": 0.1,
  "pint_enc_layers": 1,
  "pint_enc_heads": 1,
  "pint_ctx_layers": 6,
  "pint_ctx_heads": 8,
  "pint_dyn_layers": 8,
  "pint_dyn_heads": 8,
  "pint_dim": 512,
  "run_prefix": "_robomme",
  "animation_horizon": 14,
  "cond_steps": 10,
  "eval_im_metrics": false,
  "ctx_for_eval": false,
  "animation_fps": 12.0,
  "iou_thresh": 0.2
}